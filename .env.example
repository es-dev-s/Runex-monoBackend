# Platform API — copy to backend/.env and fill in values.
# Existing process environment wins over this file.
# On the VPS, keep this file as-is and run deploy/vps/install.sh; it copies
# secrets and rewrites only origins, bind addresses, workdir, Redis, and the PEM path.

# Optional 32-byte hex/base64 root key that wraps each user's vault DEK.
# If unset, the API generates one at PLATFORM_WORKDIR/.vault-root (mode 0600).
# PLATFORM_VAULT_KEY=
PLATFORM_ENV=development
PLATFORM_ADDR=0.0.0.0:8080
PLATFORM_WEB_URL=http://localhost:3000
# Public Railway UI origin when the dashboard is hosted. Required for Secure cookies
# and GitHub App return: PLATFORM_WEB_URL=https://YOUR-FRONTEND.up.railway.app
PLATFORM_REDIS_URL=redis://127.0.0.1:6379/0
# LAN Postgres. Existing process environment wins over this file.
# PLATFORM_DATABASE_URL=postgres://user:pass@10.80.80.228:5432/mesh_p_deployment_db?sslmode=disable

# Device-native app hostnames (browsers resolve *.app.localhost with no DNS).
# Production: one DNS label (salesradar.live) so Universal SSL covers
# https://<app>.salesradar.live. Nested *.deploy.salesradar.live needs a paid cert.
PLATFORM_EDGE_DOMAIN=app.localhost
PLATFORM_PUBLIC_BASE=http://app.localhost
# Optional. When wildcard DNS is missing, publish http://<dashboard>/apps/<name>
# instead of http://<name>.<edge-domain>.
# PLATFORM_APP_PATH_PREFIX=/apps
# Optional LAN name. Only used after internal DNS exists; not shown until then.
PLATFORM_LAN_DOMAIN=apps.company.local

# Custom domains: customers CNAME (Proxied) to cname.<EDGE_DOMAIN>.
# Runex creates a Cloudflare for SaaS custom hostname so that CNAME is
# legal from any Cloudflare account (avoids Error 1014).
# PLATFORM_CNAME_TARGET=cname.salesradar.live
# PLATFORM_TUNNEL_CNAME=<tunnel-id>.cfargotunnel.com
# PLATFORM_DOMAIN_ORIGIN=http://127.0.0.1:18080
# CLOUDFLARE_API_TOKEN=   # Zone SSL Edit + Zone Read + Account Cloudflare Tunnel Edit
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_TUNNEL_ID=
# CLOUDFLARE_ZONE_ID=

# Origin GitHub can reach for webhooks (tunnel in development).
PLATFORM_PUBLIC_URL=http://localhost:3000

# Per-node RAM/disk caps the dashboard can assign. Isolation is applied with
# Docker memory cgroups (hard) and a reserved disk quota (measured live).
# PLATFORM_MAX_MEMORY_MB=4096
# PLATFORM_MAX_DISK_MB=20480
